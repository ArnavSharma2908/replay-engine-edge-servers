	<!-- 2019-06-27 moved from baseline.xml-->
	<cache:uvm.cache-size>400</cache:uvm.cache-size>
	<cache:uvm.initial-cache-size>300</cache:uvm.initial-cache-size>
	<cache:uvm.max-cache-size>400</cache:uvm.max-cache-size>
	
	<!-- preparing for UVM feature default enable mode CR 4094481-->
	<cache:uvm>
    <status>on</status>
	  <cache-size>400</cache-size>
		<lazy-writer>
			<max-dirty-pages-ratio-percent>0</max-dirty-pages-ratio-percent>
		</lazy-writer>
	</cache:uvm>	
	 <config:rollback.uvm-release-under-pressure>on</config:rollback.uvm-release-under-pressure>
	 
	 <!-- 2019-01-10 preventing occasional coredumps caused by 2 ghost processes running at the same time -->
	<cache:uvm.aio.io-setup-max-events>32000</cache:uvm.aio.io-setup-max-events>

    <!-- 2016-07-26 Enable FPJ1 mode in test environment -->
    <config:fast-purge.status>on</config:fast-purge.status>
    <!-- 2016-10-20 Enable FPJ public suffix in test since enabled in production -->
    <config:fast-purge.new-public-suffix-rules.status>on</config:fast-purge.new-public-suffix-rules.status>

    <!-- 2012-12-15 Enable IPv6 mode in test environment -->
    <network:ipv6.status>on</network:ipv6.status>

    <!-- 2011-09-29 Bypass debug message rate limiting for testing -->
    <reporting:debug-rate-limiting-override>on</reporting:debug-rate-limiting-override>

    <!-- 2010-02-08 suggested by Chunhui as ghosts in the field are using 60s -->
    <config:stalled-thread-detect.heartbeat-timeout>60s</config:stalled-thread-detect.heartbeat-timeout>

