    # This below mdt will make the meta updates pass when estest
    # are run in ipv6 mode. This might need some change when CR 870329
    # is addressed.
    <network:http.access>allow META_UPDATE localhost6</network:http.access>
    <network:http.access>deny META_UPDATE !localhost</network:http.access>
    <network:http.access>deny manager !mgr_ports</network:http.access>
    <network:http.access>allow valid_methods</network:http.access>

